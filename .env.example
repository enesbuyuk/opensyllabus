# ---------------------------------------------------------------------------
# OpenSyllabus configuration. Copy to `.env` and adjust.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# Public origin of the site (used for cookies, CSRF origin checks and links).
PUBLIC_URL=https://lms.example.com

# Send cookies with the Secure flag and enable HSTS. Defaults to true for https PUBLIC_URL.
COOKIE_SECURE=true

# Trust X-Forwarded-For / X-Real-IP from the reverse proxy (needed for correct
# rate limiting and audit IPs). Only enable when the app is reachable solely via the proxy.
TRUST_PROXY=true

# Sliding session lifetime in hours.
SESSION_TTL_HOURS=168

# Platform timezone (IANA name, e.g. Europe/Istanbul, America/New_York). Deadlines are
# stored in UTC and shown in each user's own timezone. Can also be changed in Settings.
DEFAULT_TIMEZONE=UTC

# Maximum size of a single upload (MB). Assignments may set a lower limit.
MAX_UPLOAD_MB=50

# Seed an example course on first start: a 48-week draft curriculum skeleton
# ("Light-Based Tactile Robotic Hand", 8 modules). Useful for evaluating the platform.
SEED_INITIAL_COURSE=false

# Logging: RUST_LOG filter and LOG_FORMAT=json for structured logs.
RUST_LOG=info,tower_http=info,sqlx=warn
LOG_FORMAT=text

# Host port the container is published on (127.0.0.1 only).
HOST_PORT=8080

# Optional one-time administrator bootstrap. Only used when no administrator
# exists yet. Remove the password from this file after the first start.
# Preferred alternative: docker compose run --rm opensyllabus create-admin --email you@example.com
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Instructor

# Development only: extra origins allowed to send mutating requests (comma separated).
# ALLOWED_ORIGINS=http://localhost:5173

# Local (non-Docker) paths.
# DATABASE_PATH=./data/opensyllabus.db
# STORAGE_DIR=./storage
# STATIC_DIR=../frontend/dist
# BIND_ADDR=127.0.0.1:8080
